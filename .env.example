# URL do deployment do Apps Script que serve a planilha (termina em /exec).
VITE_SHEET_SYNC_URL=

# —— Sessão da plataforma Product Ops ——————————————————————————————
# Estas três NÃO têm prefixo VITE_ de propósito: são lidas no vite.config.js e
# usadas só no servidor — o middleware do Vite em dev (src/server/auth-api.js) e
# as funções em produção (api/auth/*.js). Com prefixo VITE_ o segredo entraria no
# bundle do browser.
#
# Em produção elas vivem em Project Settings → Environment Variables na Vercel;
# este arquivo é só o ambiente local.

# Base dos webhooks do n8n, sem barra no fim (o mesmo N8N_BASE_URL da plataforma).
N8N_BASE_URL=
# Segredo do JWT — igual à credencial "JWT ProductOps" no n8n e ao JWT_SECRET da
# plataforma. Sem ele o app não valida sessão nenhuma.
JWT_SECRET=
# Projeto da plataforma que define o papel aqui. Padrão: fila-dev (id 10, setor
# Produto). Concessão admin nele = pode incluir card no Roadmap; sem concessão,
# sem acesso ao app.
PLATFORM_PROJECT_SLUG=fila-dev
