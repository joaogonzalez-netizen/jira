# —— Sessão da plataforma Product Ops ——————————————————————————————
# Estas três também não têm prefixo VITE_ de propósito, pelo mesmo motivo: são
# lidas no vite.config.js e usadas só no servidor — o middleware do Vite em dev
# (src/server/auth-api.js) e as funções em produção (api/auth/*.js).
#
# Em produção todas essas variáveis vivem em Project Settings → Environment
# Variables na Vercel; este arquivo é só o ambiente local.

# Base dos webhooks do n8n, sem barra no fim (o mesmo N8N_BASE_URL da plataforma).
N8N_BASE_URL=
# Segredo do JWT — igual à credencial "JWT ProductOps" no n8n e ao JWT_SECRET da
# plataforma. Sem ele o app não valida sessão nenhuma.
JWT_SECRET=
# Projeto da plataforma que define o papel aqui. Padrão: fila-dev (id 10, setor
# Produto). Concessão admin nele = pode incluir card no Roadmap; sem concessão,
# sem acesso ao app.
PLATFORM_PROJECT_SLUG=fila-dev

# —— Iniciativas (Produto → Iniciativa → Épico) ——————————————————————
# Guardadas só dentro deste app (não vêm do Jira), num Redis vinculado a
# este mesmo projeto. Também sem prefixo VITE_: lidas no vite.config.js em
# dev (src/server/initiatives-api.js) e na função em produção
# (api/initiatives.js).
#
# Como configurar: Vercel Dashboard → projeto "jira" → Storage → Create
# Database → Redis (via Marketplace) → conectar a este projeto. A variável
# abaixo é injetada automaticamente em produção; para rodar local,
# `vercel env pull .env.development.local` depois de conectar.
REDIS_URL=

# —— Jira (leitura dos épicos e tarefas, e escrita pelo Roadmap) ————————————
# Lidas só no servidor (src/server/jira-read-core.js e jira-core.js em dev;
# api/jira/*.js em produção). É a ÚNICA fonte dos dados: sem JIRA_EMAIL e
# JIRA_API_TOKEN o botão Atualizar responde que o Jira não está configurado.
# Para testar sem o Jira, use `npm run dev:mock` (dados de exemplo).
#
# Como gerar o token: https://id.atlassian.com/manage-profile/security/api-tokens
# → "Create API token". Use uma conta que leia todos os projetos (FLIX, IA,
# SELLER, LOJA, BACK, ACADEMY, CUSTOM, POD, DADOS…) e possa criar, editar e
# transicionar épicos neles.
# Em produção: Vercel → Project Settings → Environment Variables. NUNCA commitar.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Opcional — padrão: https://joaogonzalezstlflix.atlassian.net
JIRA_BASE_URL=
