# —— Sincronização da planilha "[Dados] Jira 2" ————————————————————
# Sem prefixo VITE_ de propósito: lida só no servidor (src/server/sheet-core.js,
# via vite.config.js em dev e api/sheet/sync.js em produção). Substitui o antigo
# Apps Script Web App (apps-script/sync.gs.js) — não precisa mais implantar nada
# manualmente nem deixar a planilha pública como "Anyone".
#
# Como gerar: Google Cloud Console → IAM e administrador → Contas de serviço →
# Criar conta de serviço → Chaves → Adicionar chave (JSON). Depois compartilhe a
# planilha com o "client_email" da chave (papel Leitor).
# Cole o conteúdo INTEIRO do arquivo .json baixado, numa linha só.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcional — padrão é a planilha "[Dados] Jira 2" já usada pelo app.
GOOGLE_SHEET_ID=

# —— Sessão da plataforma Product Ops ——————————————————————————————
# Estas três também não têm prefixo VITE_ de propósito, pelo mesmo motivo: são
# lidas no vite.config.js e usadas só no servidor — o middleware do Vite em dev
# (src/server/auth-api.js) e as funções em produção (api/auth/*.js).
#
# Em produção todas essas variáveis vivem em Project Settings → Environment
# Variables na Vercel; este arquivo é só o ambiente local.

# Base dos webhooks do n8n, sem barra no fim (o mesmo N8N_BASE_URL da plataforma).
N8N_BASE_URL=
# Segredo do JWT — igual à credencial "JWT ProductOps" no n8n e ao JWT_SECRET da
# plataforma. Sem ele o app não valida sessão nenhuma.
JWT_SECRET=
# Projeto da plataforma que define o papel aqui. Padrão: fila-dev (id 10, setor
# Produto). Concessão admin nele = pode incluir card no Roadmap; sem concessão,
# sem acesso ao app.
PLATFORM_PROJECT_SLUG=fila-dev
